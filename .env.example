# --- Database (Neon Postgres in production; any Postgres locally) ---
# Use the POOLED connection string on Vercel.
# Local dev server: `npm run db:local` starts a real PostgreSQL on port 5433.
DATABASE_URL="postgresql://postgres:password@localhost:5433/insurance_mvp"

# Tests REFUSE to run against a non-local database (they write and clean
# rows). This override lets DATABASE_URL point at Neon while tests stay local.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5433/insurance_mvp"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32+-char-secret"

# --- App ---
APP_URL="http://localhost:3000"

# --- Payments (Razorpay TEST mode) ---
# Absent keys → in-memory mock provider (dev/tests only). The deployment MUST
# set real test-mode keys so the reviewer can pay with test cards.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# The dashboard's webhook secret. Without it a dev default is used so
# signed-fixture tests work — NEVER rely on the default in a deployment.
# RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
# EMAIL_MODE=log              # live = real sends via Resend; log = render into
#                             # the communications log only (default)
# RESEND_API_KEY=
# EMAIL_FROM="Insurance Agent Platform <onboarding@resend.dev>"

# --- WhatsApp ---
# WHATSAPP_MODE=demo          # demo (wa.me click-to-chat) | cloud-api

# --- PDF storage ---
# Absent → local file fallback under var/pdf-storage (dev only)
# BLOB_READ_WRITE_TOKEN=
